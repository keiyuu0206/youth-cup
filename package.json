{
  "name": "youth-cup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "少年サッカー大会の運営アプリ（Cloudflare Workers + D1）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test lib.test.js",
    "test:e2e": "node e2e.mjs",
    "db:init:local": "wrangler d1 execute youth-cup-db --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute youth-cup-db --remote --file=schema.sql",
    "test:fuzz": "node --test fuzz.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  },
  "engines": {
    "node": ">=20"
  }
}
