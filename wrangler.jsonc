{
  "name": "youth-cup",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  // 画面のファイルを文字列として Worker に同梱する
  "rules": [
    { "type": "Text", "globs": ["**/*.html", "**/*.css", "**/*.webmanifest", "**/web-*.js"], "fallthrough": false }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "youth-cup-db",
      // Cloudflare の D1 で作成したデータベースの ID に置き換えてください
      "database_id": "0addbc7a-3e31-4187-8d98-5e750780661e"
    }
  ],
  // 利用マニュアル（PDF）を manuals フォルダから配信する（/INFINEX_manual_parents.pdf など）
  "assets": { "directory": "./manuals" },
  "observability": { "enabled": true }
}
